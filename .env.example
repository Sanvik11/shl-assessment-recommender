# Copy to .env and fill in for the production (Gemini-powered) path.
# If GEMINI_API_KEY is unset, the app automatically runs on the offline
# rule-based backend + TF-IDF retriever -- no key needed for local dev/testing.

GEMINI_API_KEY=
# auto | gemini | offline  (auto picks gemini iff GEMINI_API_KEY is set)
LLM_PROVIDER=auto
PORT=8000
